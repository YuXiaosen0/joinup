<view class="team-container"><view class="header"><text class="title">组队</text></view><view class="icon-nav"><view class="icon-item" bindtap="{{a}}"><view class="icon-box"><image src="https://joinup.oss-cn-beijing.aliyuncs.com/images/message/staronhand.png" mode="aspectFit"></image></view><text class="icon-text">发起新的组队</text></view><view class="icon-item" bindtap="{{b}}"><view class="icon-box"><image src="https://joinup.oss-cn-beijing.aliyuncs.com/images/message/handsup.png" mode="aspectFit"></image></view><text class="icon-text">我已发起的队伍</text></view><view class="icon-item" bindtap="{{c}}"><view class="icon-box"><image src="https://joinup.oss-cn-beijing.aliyuncs.com/images/message/claphands.png" mode="aspectFit"></image></view><text class="icon-text">我已加入的队伍</text></view></view><view wx:if="{{d}}" class="create-team-form"><view class="form-item"><text class="form-label">队伍名称</text><input class="form-input" placeholder="请输入队伍名称(1-60字符)" maxlength="60" value="{{e}}" bindinput="{{f}}"/></view><view class="form-item"><text class="form-label">队伍介绍</text><block wx:if="{{r0}}"><textarea class="form-textarea" placeholder="请输入队伍介绍(选填)" value="{{g}}" bindinput="{{h}}"/></block></view><view class="form-item"><text class="form-label">队伍主题</text><input class="form-input" placeholder="请输入队伍主题ID" type="number" value="{{i}}" bindinput="{{j}}"/></view><view class="form-item"><text class="form-label">队伍是否公开</text><switch checked="{{k}}" bindchange="{{l}}"/></view><view class="form-item"><text class="form-label">最大人数</text><input class="form-input" placeholder="请输入最大人数(不超过100)" type="number" maxlength="3" value="{{m}}" bindinput="{{n}}"/></view><view class="form-item"><text class="form-label">队伍标签</text><input class="form-input" placeholder="请输入队伍标签ID，多个用逗号分隔(最多10个)" value="{{o}}" bindinput="{{p}}"/></view><button class="create-button" bindtap="{{q}}">确认创建</button></view><view wx:if="{{r}}" class="current-type-hint"><text>{{s}}</text></view><scroll-view scroll-y class="team-list" bindscrolltolower="{{z}}" refresher-enabled refresher-triggered="{{A}}" bindrefresherrefresh="{{B}}"><view wx:for="{{t}}" wx:for-item="item" wx:key="h" class="team-card" bindtap="{{item.i}}"><view class="team-name">{{item.a}}</view><view wx:if="{{item.b}}" class="team-description">{{item.c}}</view><view class="team-info"><text class="team-members">成员: {{item.d}}/{{item.e}}</text><text class="{{['team-status', item.g]}}">{{item.f}}</text></view></view><view wx:if="{{v}}" class="empty-tips"><image src="{{w}}" mode="aspectFit"></image><text>{{x}}</text></view><view wx:if="{{y}}" class="loading-more"><text>加载中...</text></view></scroll-view></view>