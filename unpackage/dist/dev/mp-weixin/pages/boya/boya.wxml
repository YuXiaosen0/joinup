<view class="container"><view class="header"><view class="nav-tabs"><view class="{{['tab', a]}}" bindtap="{{b}}"> 全部课程 </view><view class="{{['tab', c]}}" bindtap="{{d}}"> 已选课程 </view><view class="{{['tab', e]}}" bindtap="{{f}}"> 预约记录 </view></view></view><view wx:if="{{g}}" class="course-list"><view wx:for="{{h}}" wx:for-item="course" wx:key="l" class="course-card"><view class="course-info"><text class="course-name">{{course.a}}</text><text class="course-time">时间: {{course.b}} 至 {{course.c}}</text><text class="course-college">学院: {{course.d}}</text></view><view class="course-actions"><button wx:if="{{course.e}}" class="action-btn select-btn" bindtap="{{course.f}}"> 选课 </button><button wx:elif="{{course.g}}" class="action-btn cancel-btn" bindtap="{{course.h}}"> 退选 </button><button wx:else class="action-btn disabled-btn"> 无法选课 </button><button wx:if="{{course.i}}" class="action-btn appointment-btn" bindtap="{{course.j}}"> 预约 </button><button wx:elif="{{course.k}}" class="action-btn disabled-btn" disabled> 已预约 </button><button wx:else class="action-btn disabled-btn" disabled> 当前时间无法预约 </button></view></view><view class="pagination"><button disabled="{{i}}" class="page-btn" bindtap="{{j}}"> 上一页 </button><picker class="page-picker" mode="selector" range="{{l}}" value="{{m}}" bindchange="{{n}}"><view class="picker-text"> 每页 {{k}} 条 </view></picker><picker class="page-picker" mode="selector" range="{{p}}" value="{{q}}" bindchange="{{r}}"><view class="picker-text"> 第 {{o}} 页 </view></picker><button class="page-btn" bindtap="{{s}}"> 下一页 </button></view></view><view wx:elif="{{t}}" class="course-list"><view wx:if="{{v}}" class="empty-tip"><text>暂无已选课程</text></view><view wx:for="{{w}}" wx:for-item="course" wx:key="g" class="course-card"><view class="course-info"><text class="course-name">{{course.a}}</text><text class="course-time">时间: {{course.b}} 至 {{course.c}}</text><text class="course-college">学院: {{course.d}}</text><text class="course-position">地点: {{course.e}}</text></view><view class="course-actions"><button class="action-btn cancel-btn" bindtap="{{course.f}}"> 退选 </button></view></view></view><view wx:else class="appointment-list"><view wx:if="{{x}}" class="empty-tip"><text>暂无预约记录</text></view><view wx:for="{{y}}" wx:for-item="appointment" wx:key="d" class="appointment-card"><view class="appointment-info"><text class="appointment-name">{{appointment.a}}</text><text class="appointment-time">课程开选时间: {{appointment.b}}</text></view><button class="action-btn cancel-btn" bindtap="{{appointment.c}}"> 撤销预约 </button></view></view></view>