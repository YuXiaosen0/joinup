<view class="container"><view class="header"><view class="nav-tabs"><view class="{{['tab', a]}}" bindtap="{{b}}"> 全部课程 </view><view class="{{['tab', c]}}" bindtap="{{d}}"> 已选课程 </view><view class="{{['tab', e]}}" bindtap="{{f}}"> 预约记录 </view></view></view><view wx:if="{{g}}" class="course-list"><view wx:for="{{h}}" wx:for-item="course" wx:key="i" class="course-card"><view class="course-info"><text class="course-name">{{course.a}}</text><text class="course-time">时间: {{course.b}} 至 {{course.c}}</text><text class="course-college">学院: {{course.d}}</text></view><view class="course-actions"><button wx:if="{{course.e}}" class="action-btn select-btn" bindtap="{{course.f}}"> 选课 </button><button wx:else class="action-btn cancel-btn" bindtap="{{course.g}}"> 退选 </button><button class="action-btn appointment-btn" bindtap="{{course.h}}"> 预约 </button></view></view><view class="pagination"><button disabled="{{i}}" class="page-btn" bindtap="{{j}}"> 上一页 </button><text class="page-info">第 {{k}} 页</text><button class="page-btn" bindtap="{{l}}"> 下一页 </button></view></view><view wx:elif="{{m}}" class="course-list"><view wx:if="{{n}}" class="empty-tip"><text>暂无已选课程</text></view><view wx:for="{{o}}" wx:for-item="course" wx:key="j" class="course-card"><view class="course-info"><text class="course-name">{{course.a}}</text><text class="course-time">时间: {{course.b}} 至 {{course.c}}</text><text class="course-college">学院: {{course.d}}</text><text class="course-position">地点: {{course.e}}</text><text class="course-identifier">选课标识: {{course.f}}</text></view><view class="course-actions"><button class="action-btn cancel-btn" bindtap="{{course.g}}"> 退选 </button><button wx:if="{{course.h}}" class="action-btn appointment-btn" bindtap="{{course.i}}"> 预约打卡 </button><button wx:else class="action-btn disabled-btn" disabled> 已预约 </button></view></view></view><view wx:else class="appointment-list"><view wx:if="{{p}}" class="empty-tip"><text>暂无预约记录</text></view><view wx:for="{{q}}" wx:for-item="appointment" wx:key="d" class="appointment-card"><view class="appointment-info"><text class="appointment-name">{{appointment.a}}</text><text class="appointment-time">预约时间: {{appointment.b}}</text></view><button class="action-btn cancel-btn" bindtap="{{appointment.c}}"> 撤销预约 </button></view></view><view class="auth-status"><text wx:if="{{r}}" class="authenticated">已通过北航校园认证</text><button wx:else class="auth-btn" bindtap="{{s}}">进行北航校园认证</button></view></view>