
.auth-container.data-v-08418ad3 {
	padding: 40rpx;
    background: linear-gradient(135deg, #f5f7fa 0%, #e4eaf2 100%);
    min-height: 100vh;
    display: flex;
    flex-direction: column; /* 垂直布局 */
    justify-content: center; /* 垂直居中 */
    align-items: center; /* 水平居中 */
    gap: 40rpx; /* 图片和卡片之间的间距 */
}
.logo-container.data-v-08418ad3 {
  display: flex;
  justify-content: center;
  align-items: center;
}
.logo.data-v-08418ad3 {
  width: 400rpx; /* 图片宽度 */
  height: 400rpx; /* 图片高度 */
  object-fit: contain; /* 保持图片比例 */
}
.auth-header.data-v-08418ad3 {
  margin-bottom: 60rpx;
  text-align: center;
}
.auth-title.data-v-08418ad3 {
  font-size: 42rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}
.auth-subtitle.data-v-08418ad3 {
  font-size: 28rpx;
